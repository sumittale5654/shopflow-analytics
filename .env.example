# ── PostgreSQL source ──────────────────────────────────────────
SHOPFLOW_PG_HOST=localhost
SHOPFLOW_PG_PORT=5433
SHOPFLOW_PG_DB=shopflow_db
SHOPFLOW_PG_USER=shopflow
SHOPFLOW_PG_PASSWORD=shopflow123

# ── AWS ────────────────────────────────────────────────────────
# Get these from AWS Console → IAM → Users → Security credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1
S3_BUCKET=shopflow-analytics-lake

# ── Snowflake ──────────────────────────────────────────────────
# Get ACCOUNT from: Admin → Accounts → hover your account name
# Format: orgname-accountname  (e.g. myorg-ab12345)
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=SHOPFLOW_DWH
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_WAREHOUSE=SHOPFLOW_WH
SNOWFLAKE_ROLE=SYSADMIN

# ── Local paths ────────────────────────────────────────────────
DATA_DIR=/app/data
